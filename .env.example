# ============================================
# 西秦模型管理平台 - 环境变量配置示例
# 使用方法：复制本文件为 .env，然后修改密码等配置
# ============================================

# Compose项目名（可自定义）
COMPOSE_PROJECT_NAME=xiqin

# 服务绑定IP（0.0.0.0=允许局域网访问，127.0.0.1=仅本机）
APP_BIND_IP=0.0.0.0
APP_PORT=8088

# 时区
TZ=Asia/Shanghai

# ============================================
# PostgreSQL 数据库
# ============================================
POSTGRES_DB=xiqin
POSTGRES_USER=xiqin
POSTGRES_PASSWORD=请修改为强密码

# ============================================
# Redis 缓存
# ============================================
REDIS_PASSWORD=请修改为强密码

# ============================================
# RabbitMQ 消息队列
# ============================================
RABBITMQ_USER=xiqin
RABBITMQ_PASSWORD=请修改为强密码

# ============================================
# MinIO 对象存储
# ============================================
MINIO_ROOT_USER=xiqin
MINIO_ROOT_PASSWORD=请修改为至少8位强密码

# MinIO公共访问地址（局域网访问时填本机IP，如 http://192.168.1.100:8088/minio）
# 仅本机访问时可留空，默认使用容器内部地址
MINIO_PUBLIC_ENDPOINT=

# ============================================
# JWT 密钥（必须修改，用于用户登录鉴权）
# ============================================
JWT_SECRET=请修改为随机长字符串，至少32位

# ============================================
# 初始管理员账号（首次启动时自动创建）
# ============================================
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin@xiqin2024
INITIAL_ADMIN_EMAIL=admin@xiqin.local

# ============================================
# OnlyOffice 在线文档（可选，不需要可留空）
# ============================================
ONLYOFFICE_PORT=8089
OFFICE_PUBLIC_URL=http://127.0.0.1:8089
ONLYOFFICE_JWT_SECRET=请修改为随机字符串
