# 复制为 .env.production 后再填写。不要把真实密码提交到代码仓库。
COMPOSE_PROJECT_NAME=xiqin
# 推荐填写服务器固定局域网 IP，例如 192.168.1.20；未确定时保留 0.0.0.0
APP_BIND_IP=0.0.0.0
APP_PORT=80
# ONLYOFFICE 需要单独端口供局域网浏览器加载文档编辑器。
ONLYOFFICE_PORT=8089
# 必须填写局域网内其他电脑能访问的地址，例如 http://192.168.1.20:8089
OFFICE_PUBLIC_URL=http://SERVER_LAN_IP:8089
TZ=Asia/Shanghai

POSTGRES_DB=xiqin
POSTGRES_USER=xiqin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

RABBITMQ_USER=xiqin
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

MINIO_ROOT_USER=xiqin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# 建议使用：openssl rand -hex 64
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_JWT_SECRET
# 建议使用：openssl rand -hex 32（不要与 JWT_SECRET 共用）
ONLYOFFICE_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_ONLYOFFICE_SECRET

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
INITIAL_ADMIN_EMAIL=admin@example.com
